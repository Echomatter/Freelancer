{
  "$schema": "https://opencode.ai/config.json",

  // App-owned OpenCode configuration for the local web runtime.
  // Does not pin a parent model; the user chooses it. named agents come from the application catalog.
  "default_agent": "engineer",
  "subagent_depth": 6,
  "share": "disabled",
  "autoupdate": false,
  "snapshot": true,

  "instructions": ["../global/WORKSTYLE.md", "global-instructions.md"],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8192
  },

  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": ["uvx", "mcp-server-fetch"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "environment": { "MEMORY_FILE_PATH": "{env:FREELANCER_MCP_MEMORY_FILE}" },
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": { "Authorization": "Bearer {env:CONTEXT7_API_KEY}" },
      "oauth": false,
      "enabled": true
    },
    "jev": {
      "type": "local",
      "command": ["npx", "-y", "jev-mcp@0.5.1"],
      "environment": { "TYPESAFE_API_KEY": "{env:JEV_API_KEY}" },
      "timeout": 30000,
      "enabled": true
    }
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "target/**",
      ".venv/**",
      "venv/**",
      ".git/**",
      ".runtime/**"
    ]
  }
}
